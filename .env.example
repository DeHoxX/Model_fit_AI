# ModelFit Environment Variables

# Application Environment: development | test | production
APP_ENV=development

# Application Version and Commit SHA
APP_VERSION=1.0.0
GIT_SHA=development

# Server Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend Database URL (Async PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://modelfit:modelfit@localhost:5432/modelfit

# Test Database URL
TEST_DATABASE_URL=postgresql+asyncpg://modelfit:modelfit@localhost:5432/modelfit_test

# Allowed CORS Origins (comma-separated). Production MUST NOT contain '*'
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hugging Face API Read Token (Phase 3+)
HF_TOKEN=

# LLM Provider API Key (Phase 4+)
ANTHROPIC_API_KEY=

# Admin Token for privileged diagnostics and maintenance (Phase 5)
ADMIN_TOKEN=change_me_to_a_secure_token

# Frontend Port
PORT=3000
