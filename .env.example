# ModelFit Environment Variables

# Application Environment: development | test | production
APP_ENV=development

# Application Version and Commit SHA
APP_VERSION=1.0.0
GIT_SHA=development

# Server Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend Database URL (Async SQLite via aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./modelfit.db

# Test Database URL
TEST_DATABASE_URL=sqlite+aiosqlite:///./modelfit_test.db

# Allowed CORS Origins (comma-separated). Production MUST NOT contain '*'
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hugging Face API Read Token (Phase 3+)
HF_TOKEN=

# LLM Provider Configuration (Phase 4+)
# LLM_PROVIDER: gemini | groq
LLM_PROVIDER=gemini
# Single key (backward compatible)
LLM_API_KEY=
# Comma-separated keys for Groq API key rotation
LLM_API_KEYS=
# Recommended for gemini: gemini-2.5-flash | Recommended for groq: openai/gpt-oss-120b
LLM_MODEL=
# LLM HTTP client timeouts (in seconds)
LLM_CONNECT_TIMEOUT_SECONDS=5.0
LLM_READ_TIMEOUT_SECONDS=15.0

# Admin Token for privileged diagnostics and maintenance (Phase 5)
ADMIN_TOKEN=change_me_to_a_secure_token

# Frontend Port
PORT=3000
